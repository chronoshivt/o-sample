# Port the Bun server listens on. Coolify maps this to its proxy.
PORT=3847

# Where downloaded/cached audio + clips are written.
# Ephemeral by default — wiped on redeploy. Mount a volume here later
# if you want cached clips to persist.
DOWNLOAD_DIR=/app/downloads

# Overrides for the bundled binaries. Leave unset to use PATH lookup,
# which resolves to the ffmpeg and yt-dlp installed by the Dockerfile.
# YT_DLP=/usr/local/bin/yt-dlp
# FFMPEG=/usr/bin/ffmpeg

# HTTP/HTTPS/SOCKS5 proxy for yt-dlp. Use a residential proxy to dodge YouTube's
# "confirm you're not a bot" block that hits datacenter IPs (Coolify VPS).
# Format examples:
#   http://user:pass@host:port
#   socks5://user:pass@host:port
#   http://host:port            (no auth)
# Credentials are redacted from startup logs.
# YT_PROXY=http://user:pass@host:port

# Path to a Netscape cookies.txt for YouTube auth (helps when YouTube asks
# "confirm you're not a bot"). Cookies compose with proxy — use both together
# for maximum reliability. Export cookies in Netscape format (get-cookies-txt
# browser extension) or run a Cookie-Editor JSON → Netscape conversion.
# YT_COOKIES_FILE=/app/cookies.txt

# yt-dlp extractor player client. Defaults to tv_embedded which is the current
# workaround for "Sign in to confirm you're not a bot". If that stops working,
# try: tv, mweb, ios, android, web_creator. Set empty to fall back to default.
# YT_PLAYER_CLIENT=tv_embedded
